datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum Role {
  SUPER_ADMIN
  CUSTOMER_ADMIN
  USER
}

enum Action {
  MANAGE
  CREATE
  READ
  EDIT
  DELETE
  EXPORT
  IMPORT
  ASSIGN
  CHANGE_STATUS
}

enum Subject {
  SETTINGS
  USERS
  ROLES
  DASHBOARD_ACCESS
  LOG
  REPORTS
  QUIZZES
  LEADS
  CLASSES
}

enum QuizStatus {
  Draft
  Published
  Archived
}

/// Content language codes used by quizzes and localized JSON fields.
enum ContentLanguage {
  en
  si
  ta
}

enum TeacherQuizVisibility {
  ALL
  SELECTED
}

/// Admin review before a teacher can publish their public page.
enum TeacherReviewStatus {
  Pending
  Active
  Rejected
}

enum TeacherPosterPlacement {
  TOP
  MIDDLE
  FOOTER
  SIDE
  RIGHT
}

enum TeacherInquiryStatus {
  NEW
  READ
  ARCHIVED
}

enum QuestionStatus {
  Draft
  Published
  Archived
}

enum CourseStatus {
  Draft
  Published
  Archived
}

enum QuestionType {
  MCQ
  SHORT_TEXT
  NUMERIC
  SEQUENCE
  ESSAY
}

enum AttemptStatus {
  In_Progress
  Submitted
  Timed_Out
}

enum PaymentOrderStatus {
  Pending
  Paid
  Failed
  Cancelled
}

enum PaymentProvider {
  PayHere
}

enum UnlockMethod {
  PayHere
  Voucher
  Slip
}

enum SlipSubmissionStatus {
  Pending
  Approved
  Rejected
}

enum RevenuePeriodStatus {
  Open
  Calculating
  Settled
  Paid
}

enum TeacherPayoutStatus {
  Pending
  Approved
  Paid
  Held
}

enum PasswordResetChannel {
  EMAIL
  SMS
}

enum AuditAction {
  LOGIN
  LOGIN_FAILED
  SIGNUP
  CREATE
  UPDATE
  DELETE
  CHANGE_STATUS
}

model Permission {
  id              String         @id @default(uuid()) @db.Uuid
  action          Action
  subject         Subject
  conditions      Json?
  
  userId          String?        @db.Uuid
  user            User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  permissionSetId String?        @db.Uuid
  permissionSet   PermissionSet? @relation(fields: [permissionSetId], references: [id], onDelete: Cascade)
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  /// Null for Google-only accounts (no local password).
  passwordHash       String?
  /// Google subject (`sub`) when signed in with Google.
  googleId           String?   @unique
  role               Role      @default(USER)
  isTwoFactorEnabled Boolean   @default(false)
  twoFactorSecret    String?
  
  workspaceId        String    @db.Uuid
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  permissions        Permission[] 
  
  customRoleId       String?   @db.Uuid
  customRole         CustomRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  
  reviewsPerformed   AccessReview[] @relation("ReviewerUser")
  
  name               String?
  firstName          String?
  lastName           String?
  company            String?
  phoneNumber        String?
  address            String?
  team               String?
  status             String    @default("Active")
  
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  invitedById        String?   @db.Uuid
  invitedBy          User?     @relation("UserHierarchy", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers       User[]    @relation("UserHierarchy")
  canViewOthers      Boolean   @default(false)
  canManagePermissions Boolean @default(false)

  quizzesCreated     Quiz[]    @relation("QuizCreator")
  questionsCreated   Question[] @relation("QuestionCreator")
  quizAttempts       QuizAttempt[] @relation("StudentAttempts")
  paymentOrders      PaymentOrder[]
  quizUnlocks        QuizUnlock[]
  slipSubmissions    PaymentSlipSubmission[]
  subscriptions      StudentSubscription[]
  passwordResetTokens PasswordResetToken[]
  teacherProfile     TeacherProfile?
  auditLogs          AuditLog[]
  databaseBackups    DatabaseBackup[]
  revenueShares      TeacherRevenueShare[] @relation("TeacherRevenueShares")
  teacherPayouts     TeacherPayout[]       @relation("TeacherPayouts")
  payoutProfile      TeacherPayoutProfile?
  attemptsAsTeacher  QuizAttempt[]         @relation("AttemptTeacher")
  classBatchesOwned        ClassBatch[]      @relation("ClassBatchPrimaryTeacher")
  classTeacherAssignments  ClassTeacher[]    @relation("ClassTeacherUser")
  classSchedulesCreated    ClassSchedule[]   @relation("ClassScheduleCreator")
  classSchedulesUpdated    ClassSchedule[]   @relation("ClassScheduleUpdater")
  classEnrollments         ClassEnrollment[] @relation("StudentClassEnrollments")
  classEnrollmentsApproved ClassEnrollment[] @relation("ApprovedClassEnrollments")
  classInvitationsCreated  ClassInvitation[] @relation("ClassInvitationsCreated")
  lessonsCreated           Lesson[]          @relation("LessonCreator")
  lessonResourcesCreated   LessonResource[]  @relation("LessonResourceCreator")
  lessonProgressRecords    LessonProgress[]  @relation("StudentLessonProgress")
  classQuizAssignmentsMade ClassQuizAssignment[] @relation("ClassQuizAssigner")
  attendanceRecordsAsStudent AttendanceRecord[] @relation("StudentAttendanceRecords")
  attendanceRecordsMarked    AttendanceRecord[] @relation("TeacherAttendanceMarked")
  attendanceChangesAsStudent AttendanceChange[] @relation("StudentAttendanceChanges")
  attendanceChangesAsActor   AttendanceChange[] @relation("ActorAttendanceChanges")
  classFeePlansCreated       ClassFeePlan[]     @relation("ClassFeePlanCreator")
  tuitionInvoicesAsStudent   TuitionInvoice[]   @relation("StudentTuitionInvoices")
  tuitionAdjustmentsCreated  TuitionInvoiceAdjustment[] @relation("ActorTuitionAdjustments")
  tuitionPaymentsAsPayer     TuitionPayment[]   @relation("StudentTuitionPayments")
  tuitionPaymentsVerified    TuitionPayment[]   @relation("VerifierTuitionPayments")
  tuitionBillingAuditEvents  TuitionBillingAuditEvent[] @relation("ActorTuitionBillingAudit")
  tuitionManualSubmissions   TuitionManualPaymentSubmission[] @relation("StudentManualTuitionSubmissions")
  tuitionManualReviews       TuitionManualPaymentSubmission[] @relation("ReviewerManualTuitionSubmissions")
  tuitionReceiptsAsStudent   TuitionReceipt[]   @relation("StudentTuitionReceipts")

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([status])
  @@index([team])
  @@index([customRoleId])
  @@index([createdAt])
  @@index([invitedById])
}

/// Public branded landing for a teacher (shared DB, user-scoped — not a new workspace).
model TeacherProfile {
  id             String                 @id @default(uuid()) @db.Uuid
  userId         String                 @unique @map("user_id") @db.Uuid
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug           String                 @unique @db.VarChar(64)
  displayName    String                 @map("display_name") @db.VarChar(255)
  title          String?                @db.VarChar(255)
  description    String?                @db.Text
  /// Editable About section body on /t/{slug}
  aboutText      String?                @map("about_text") @db.Text
  /// Editable Contact section body on /t/{slug}
  contactText    String?                @map("contact_text") @db.Text
  contactPhone   String?                @map("contact_phone") @db.VarChar(64)
  contactWhatsappUrl String?            @map("contact_whatsapp_url") @db.VarChar(512)
  contactAddress String?                @map("contact_address") @db.Text
  sideBannerUrl  String?                @map("side_banner_url")
  isPublic       Boolean                @default(false) @map("is_public")
  /// Pending until an admin activates the teacher on the Users page.
  reviewStatus   TeacherReviewStatus    @default(Active) @map("review_status")
  quizVisibility TeacherQuizVisibility  @default(ALL) @map("quiz_visibility")
  /// Page-builder layout: section visibility + order for /t/{slug}
  pageLayout     Json?                  @map("page_layout")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  banners         TeacherBanner[]
  classes         TeacherClass[]
  posters         TeacherPoster[]
  selectedQuizzes TeacherProfileQuiz[]
  inquiries       TeacherContactInquiry[]

  @@index([slug])
  @@index([reviewStatus])
  @@map("teacher_profiles")
}

/// Student inquiries submitted from the public /t/{slug} Contact form.
model TeacherContactInquiry {
  id             String               @id @default(uuid()) @db.Uuid
  profileId      String               @map("profile_id") @db.Uuid
  profile        TeacherProfile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  guestSessionId String?              @map("guest_session_id") @db.VarChar(64)
  userId         String?              @map("user_id") @db.Uuid
  studentName    String               @map("student_name") @db.VarChar(255)
  mobileNumber   String               @map("mobile_number") @db.VarChar(32)
  email          String?              @db.VarChar(255)
  message        String               @db.Text
  status         TeacherInquiryStatus @default(NEW)
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@index([profileId, createdAt])
  @@index([profileId, status])
  @@map("teacher_contact_inquiries")
}

/// Quizzes explicitly featured on a teacher public page when quizVisibility = SELECTED.
model TeacherProfileQuiz {
  id        String         @id @default(uuid()) @db.Uuid
  profileId String         @map("profile_id") @db.Uuid
  profile   TeacherProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  quizId    String         @map("quiz_id") @db.Uuid
  quiz      Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now()) @map("created_at")

  @@unique([profileId, quizId])
  @@index([profileId])
  @@index([quizId])
  @@map("teacher_profile_quizzes")
}

model TeacherBanner {
  id        String         @id @default(uuid()) @db.Uuid
  profileId String         @map("profile_id") @db.Uuid
  profile   TeacherProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  imageUrl  String         @map("image_url")
  linkUrl   String?        @map("link_url")
  title     String?        @db.VarChar(255)
  subtitle  String?        @db.Text
  ctaLabel  String?        @map("cta_label") @db.VarChar(80)
  sortOrder Int            @default(0) @map("sort_order")
  isActive  Boolean        @default(true) @map("is_active")
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([profileId])
  @@map("teacher_banners")
}

model TeacherClass {
  id           String         @id @default(uuid()) @db.Uuid
  profileId    String         @map("profile_id") @db.Uuid
  profile      TeacherProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title        String         @db.VarChar(255)
  description  String?        @db.Text
  scheduleTime String?        @map("schedule_time") @db.VarChar(120)
  location     String?        @db.VarChar(255)
  classDate    String?        @map("class_date") @db.VarChar(120)
  feeLabel          String?        @map("fee_label") @db.VarChar(80)
  whatsappGroupUrl  String?        @map("whatsapp_group_url") @db.VarChar(500)
  sortOrder         Int            @default(0) @map("sort_order")
  isActive          Boolean        @default(true) @map("is_active")
  createdAt         DateTime       @default(now()) @map("created_at")

  @@index([profileId])
  @@map("teacher_classes")
}

/// Static poster / promo banners placed at top, middle, or footer of /t/{slug}
model TeacherPoster {
  id        String                 @id @default(uuid()) @db.Uuid
  profileId String                 @map("profile_id") @db.Uuid
  profile   TeacherProfile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  imageUrl  String                 @map("image_url")
  linkUrl   String?                @map("link_url")
  title     String?                @db.VarChar(255)
  placement TeacherPosterPlacement @default(MIDDLE)
  sortOrder Int                    @default(0) @map("sort_order")
  isActive  Boolean                @default(true) @map("is_active")
  createdAt DateTime               @default(now()) @map("created_at")

  @@index([profileId])
  @@map("teacher_posters")
}

model PasswordResetToken {
  id          String                @id @default(uuid()) @db.Uuid
  token       String                @unique
  userId      String                @map("user_id") @db.Uuid
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel     PasswordResetChannel
  destination String                @db.VarChar(255)
  expiresAt   DateTime              @map("expires_at")
  isUsed      Boolean               @default(false) @map("is_used")
  createdAt   DateTime              @default(now()) @map("created_at")

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

// Platform-wide settings (SMTP + SMS + billing). Singleton row id = "default".
model SystemSetting {
  id              String   @id @default("default")
  smtp            Json?
  sms             Json?
  /// { monthlyStudentFeeLkr: number, paymentMode: "MIXED"|"MONTHLY_ONLY"|"QUIZ_ONLY" }
  billing         Json?
  /// { enabled, provider, model, apiKey?, fallbacks? } — Kadaima Expert chat + WhatsApp bot
  ai              Json?
  /// { siteName, metaTitle, metaDescription, googleAnalyticsId?, ogImageUrl?, keywords? }
  seo             Json?
  /// Public home: hero, category order/visibility, quiz limits, promo section
  homepage        Json?
  /// Super-admin toggle — when false, AuditService.log() becomes a no-op.
  auditLogEnabled Boolean  @default(true) @map("audit_log_enabled")
  updatedAt       DateTime @updatedAt @map("updated_at")
  updatedBy       String?  @map("updated_by")

  @@map("system_settings")
}

enum DatabaseBackupStatus {
  PENDING
  RUNNING
  READY
  FAILED
  RESTORING
}

/// Super-admin master DB backups (pg_dump custom format on disk).
model DatabaseBackup {
  id           String                @id @default(uuid()) @db.Uuid
  label        String?               @db.VarChar(160)
  status       DatabaseBackupStatus  @default(PENDING)
  /// Absolute or app-relative path under uploads/backups
  filePath     String?               @map("file_path")
  fileName     String?               @map("file_name") @db.VarChar(255)
  sizeBytes    BigInt?               @map("size_bytes")
  checksumSha256 String?             @map("checksum_sha256") @db.VarChar(64)
  pgVersion    String?               @map("pg_version") @db.VarChar(64)
  errorMessage String?               @map("error_message") @db.Text
  createdById  String?               @map("created_by_id") @db.Uuid
  createdBy    User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  startedAt    DateTime?             @map("started_at")
  finishedAt   DateTime?             @map("finished_at")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("database_backups")
}

/// Immutable trail of major operations (auth events + CUD actions), super-admin only.
model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  action      AuditAction
  /// Module name, e.g. "USERS", "QUIZZES", "AUTH" — free text, not FK'd to Subject enum.
  subject     String      @db.VarChar(64)
  description String?     @db.Text

  actorId     String?     @map("actor_id") @db.Uuid
  actor       User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Denormalized so history reads correctly even after the user is deleted.
  actorEmail  String?     @map("actor_email")
  actorName   String?     @map("actor_name")
  actorRole   String?     @map("actor_role")

  targetId    String?     @map("target_id")
  ipAddress   String?     @map("ip_address")
  userAgent   String?     @map("user_agent")
  metadata    Json?

  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([actorId])
  @@index([subject])
  @@index([action])
  @@map("audit_logs")
}

/// Monthly student plan — unlocks eligible locked quizzes while active (see billing.paymentMode).
model StudentSubscription {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  startsAt       DateTime      @map("starts_at")
  expiresAt      DateTime      @map("expires_at")
  amountLkr      Decimal       @map("amount_lkr") @db.Decimal(12, 2)
  paymentOrderId String?       @unique @map("payment_order_id") @db.Uuid
  paymentOrder   PaymentOrder? @relation(fields: [paymentOrderId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("student_subscriptions")
}

model Workspace {
  id                 String        @id @default(uuid()) @db.Uuid
  name               String
  
  parentId           String?       @db.Uuid
  parent             Workspace?    @relation("WorkspaceHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  subWorkspaces      Workspace[]   @relation("WorkspaceHierarchy")

  isActive           Boolean       @default(true) 

  users              User[]
  
  customRoles        CustomRole[]
  permissionSets     PermissionSet[]
  accessReviews      AccessReview[]
  classBatches       ClassBatch[]
  
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model CustomRole {
  id             String         @id @default(uuid()) @db.Uuid
  name           String
  accessLevel    String
  description    String?
  
  workspaceId    String         @db.Uuid
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  permissionSets PermissionSet[] 
  
  users          User[]         
  
  lastReview     DateTime?
  owner          String         @default("System")
  status         String         @default("Active")
  isSystem       Boolean        @default(false)
  
  accessReviews  AccessReview[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([workspaceId, name])
}

model PermissionSet {
  id             String       @id @default(uuid()) @db.Uuid
  name           String
  description    String?

  workspaceId    String       @db.Uuid
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  roles          CustomRole[]   

  permissions    Permission[]   

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([workspaceId, name])
}

model AccessReview {
  id           String      @id @default(uuid()) @db.Uuid
  workspaceId  String      @db.Uuid
  workspace    Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  roleId       String      @db.Uuid
  role         CustomRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  reviewerId   String      @db.Uuid
  reviewer     User        @relation("ReviewerUser", fields: [reviewerId], references: [id], onDelete: Cascade)

  status       String
  notes        String?

  reviewedAt   DateTime    @default(now())

  @@index([workspaceId])
  @@index([reviewerId])
}

model Course {
  id          String       @id @default(uuid()) @db.Uuid
  title       Json
  description Json?
  /// Admin-authored SERP title. Falls back to `title` when blank.
  seoTitle       String?   @map("seo_title") @db.VarChar(255)
  /// Admin-authored meta description. Falls back to a derived summary when blank.
  seoDescription String?   @map("seo_description") @db.Text
  status      CourseStatus @default(Draft)
  /// Fallback catalog / home order when homepage config has no category list.
  sortOrder   Int          @default(0) @map("sort_order")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  quizzes     Quiz[]
  modules     Module[]
  classBatches ClassBatch[]

  @@map("courses")
}

model Module {
  id          String       @id @default(uuid()) @db.Uuid
  courseId    String       @map("course_id") @db.Uuid
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       Json
  description Json?
  status      CourseStatus @default(Draft)
  sortOrder   Int          @default(0) @map("sort_order")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  quizzes     Quiz[]
  attempts    QuizAttempt[]
  lessons     Lesson[]

  @@index([courseId])
  @@map("modules")
}

model Quiz {
  id                     String          @id @default(uuid()) @db.Uuid
  courseId               String          @map("course_id") @db.Uuid
  course                 Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleId               String?         @map("module_id") @db.Uuid
  module                 Module?         @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  /// Primary / default take language (first of `languages`).
  language               ContentLanguage @default(en)
  /// Languages this quiz uses — title, description, and questions must cover all.
  languages              ContentLanguage[] @default([en])
  title                  Json
  description            Json?
  /// Admin-authored SERP title. Falls back to `title` when blank.
  seoTitle               String?         @map("seo_title") @db.VarChar(255)
  /// Admin-authored meta description. Falls back to `description` when blank.
  seoDescription         String?         @map("seo_description") @db.Text
  coverImageUrl          String?         @map("cover_image_url")
  durationMinutes        Int             @map("duration_minutes")
  passingScorePercentage Int             @default(70) @map("passing_score_percentage")
  maxAttempts            Int             @default(1) @map("max_attempts")
  shuffleQuestions       Boolean         @default(false) @map("shuffle_questions")
  requiresUnlock         Boolean         @default(false) @map("requires_unlock")
  priceLkr               Decimal?        @map("price_lkr") @db.Decimal(12, 2)
  status                 QuizStatus      @default(Draft)
  createdById            String         @map("created_by") @db.Uuid
  createdBy              User           @relation("QuizCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")
  quizQuestions          QuizQuestion[]
  sections               QuizSection[]
  attempts               QuizAttempt[]
  paymentOrders          PaymentOrder[]
  unlocks                QuizUnlock[]
  unlockVouchers         UnlockVoucher[]
  slipSubmissions        PaymentSlipSubmission[]
  teacherPageSelections  TeacherProfileQuiz[]
  chatLeads              ChatLead[]
  classQuizAssignments   ClassQuizAssignment[]

  @@index([courseId])
  @@index([moduleId])
  @@index([createdById])
  @@index([status])
  @@map("quizzes")
}

/// Instruction / passage block that groups nested questions on a quiz.
model QuizSection {
  id          String         @id @default(uuid()) @db.Uuid
  quizId      String         @map("quiz_id") @db.Uuid
  quiz        Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  /// Localized instruction or comprehension passage { en, si, ta }.
  instruction Json
  sortOrder   Int            @map("sort_order")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  quizQuestions QuizQuestion[]

  @@index([quizId])
  @@map("quiz_sections")
}

model PaymentOrder {
  id                String             @id @default(uuid()) @db.Uuid
  orderId           String             @unique @map("order_id") @db.VarChar(64)
  /// Null for monthly subscription checkouts.
  quizId            String?            @map("quiz_id") @db.Uuid
  quiz              Quiz?              @relation(fields: [quizId], references: [id], onDelete: Cascade)
  /// QUIZ | SUBSCRIPTION
  purpose           String             @default("QUIZ") @db.VarChar(32)
  guestSessionId    String?            @map("guest_session_id") @db.VarChar(64)
  userId            String?            @map("user_id") @db.Uuid
  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  amountLkr         Decimal            @map("amount_lkr") @db.Decimal(12, 2)
  currency          String             @default("LKR") @db.VarChar(3)
  status            PaymentOrderStatus @default(Pending)
  provider          PaymentProvider    @default(PayHere)
  providerPaymentId String?            @map("provider_payment_id") @db.VarChar(64)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  unlock            QuizUnlock?
  subscription      StudentSubscription?

  @@index([quizId])
  @@index([guestSessionId])
  @@index([userId])
  @@index([purpose])
  @@map("payment_orders")
}

model UnlockVoucher {
  id            String    @id @default(uuid()) @db.Uuid
  code          String    @unique @db.VarChar(64)
  quizId        String?   @map("quiz_id") @db.Uuid
  quiz          Quiz?     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  maxRedemptions Int      @default(1) @map("max_redemptions")
  redemptionCount Int     @default(0) @map("redemption_count")
  expiresAt     DateTime? @map("expires_at")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  unlocks       QuizUnlock[]

  @@index([quizId])
  @@map("unlock_vouchers")
}

model PaymentSlipSubmission {
  id             String               @id @default(uuid()) @db.Uuid
  quizId         String               @map("quiz_id") @db.Uuid
  quiz           Quiz                 @relation(fields: [quizId], references: [id], onDelete: Cascade)
  guestSessionId String?              @map("guest_session_id") @db.VarChar(64)
  userId         String?              @map("user_id") @db.Uuid
  user           User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  slipImageUrl   String               @map("slip_image_url")
  bankReference  String?              @map("bank_reference") @db.VarChar(100)
  note           String?
  status         SlipSubmissionStatus @default(Pending)
  reviewedAt     DateTime?            @map("reviewed_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  unlock         QuizUnlock?

  @@index([quizId])
  @@index([guestSessionId])
  @@index([userId])
  @@map("payment_slip_submissions")
}

model QuizUnlock {
  id                String                 @id @default(uuid()) @db.Uuid
  quizId            String                 @map("quiz_id") @db.Uuid
  quiz              Quiz                   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  guestSessionId    String?                @map("guest_session_id") @db.VarChar(64)
  userId            String?                @map("user_id") @db.Uuid
  user              User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  method            UnlockMethod
  paymentOrderId    String?                @unique @map("payment_order_id") @db.Uuid
  paymentOrder      PaymentOrder?          @relation(fields: [paymentOrderId], references: [id], onDelete: SetNull)
  voucherCodeId     String?                @map("voucher_code_id") @db.Uuid
  voucher           UnlockVoucher?         @relation(fields: [voucherCodeId], references: [id], onDelete: SetNull)
  slipSubmissionId  String?                @unique @map("slip_submission_id") @db.Uuid
  slipSubmission    PaymentSlipSubmission? @relation(fields: [slipSubmissionId], references: [id], onDelete: SetNull)
  createdAt         DateTime               @default(now()) @map("created_at")

  @@unique([quizId, guestSessionId])
  @@unique([quizId, userId])
  @@index([guestSessionId])
  @@index([userId])
  @@map("quiz_unlocks")
}

model Question {
  id           String         @id @default(uuid()) @db.Uuid
  questionText Json           @map("question_text")
  type         QuestionType   @default(MCQ)
  points       Int            @default(1)
  status       QuestionStatus @default(Draft)
  imageUrl     String?        @map("image_url")
  config       Json?
  tags         String[]       @default([])
  createdById  String?        @map("created_by") @db.Uuid
  createdBy    User?          @relation("QuestionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  choices      AnswerChoice[]
  quizLinks    QuizQuestion[]
  responses    StudentResponse[]

  @@index([createdById])
  @@index([status])
  @@map("questions")
}

model QuizQuestion {
  id         String       @id @default(uuid()) @db.Uuid
  quizId     String       @map("quiz_id") @db.Uuid
  quiz       Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionId String       @map("question_id") @db.Uuid
  question   Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  /// Null = ungrouped (legacy flat quizzes).
  sectionId  String?      @map("section_id") @db.Uuid
  section    QuizSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  sortOrder  Int          @map("sort_order")

  @@unique([quizId, questionId])
  @@index([quizId])
  @@index([questionId])
  @@index([sectionId])
  @@map("quiz_questions")
}

model AnswerChoice {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  choiceText Json     @map("choice_text")
  /// Optional image for image-based MCQ / sequence options.
  imageUrl   String?  @map("image_url")
  isCorrect  Boolean  @default(false) @map("is_correct")
  responses  StudentResponse[]

  @@index([questionId])
  @@map("answer_choices")
}

model GuestLead {
  id                String        @id @default(uuid()) @db.Uuid
  guestSessionId    String        @unique @map("guest_session_id")
  studentName       String        @map("student_name") @db.VarChar(255)
  school            String        @db.VarChar(255)
  mobileNumber      String        @map("mobile_number") @db.VarChar(20)
  email             String?       @db.VarChar(255)
  quizAttemptsCount Int           @default(0) @map("quiz_attempts_count")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  attempts          QuizAttempt[]

  @@index([mobileNumber])
  @@map("guest_leads")
}

model QuizAttempt {
  id               String        @id @default(uuid()) @db.Uuid
  quizId           String        @map("quiz_id") @db.Uuid
  quiz             Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  moduleId         String?       @map("module_id") @db.Uuid
  module           Module?       @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  studentId        String?       @map("student_id") @db.Uuid
  student          User?         @relation("StudentAttempts", fields: [studentId], references: [id], onDelete: SetNull)
  guestLeadId      String?       @map("guest_lead_id") @db.Uuid
  guestLead        GuestLead?    @relation(fields: [guestLeadId], references: [id], onDelete: Cascade)
  /// Denormalized quiz owner for revenue settlement (set at attempt start).
  teacherUserId    String?       @map("teacher_user_id") @db.Uuid
  teacher          User?         @relation("AttemptTeacher", fields: [teacherUserId], references: [id], onDelete: SetNull)
  resultToken      String?       @unique @map("result_token")
  startedAt        DateTime      @default(now()) @map("started_at")
  expiresAt        DateTime      @map("expires_at")
  submittedAt      DateTime?     @map("submitted_at")
  lastActivityAt   DateTime      @default(now()) @map("last_activity_at")
  secondsRemaining Int           @map("seconds_remaining")
  violationCount   Int           @default(0) @map("violation_count")
  lastHeartbeatAt  DateTime      @default(now()) @map("last_heartbeat_at")
  questionOrder    Json?         @map("question_order")
  status           AttemptStatus @default(In_Progress)
  finalScore       Int           @default(0) @map("final_score")
  isPassed         Boolean       @default(false) @map("is_passed")
  responses        StudentResponse[]

  @@index([quizId])
  @@index([moduleId])
  @@index([studentId])
  @@index([guestLeadId])
  @@index([teacherUserId])
  @@index([submittedAt, status])
  @@index([teacherUserId, submittedAt])
  @@index([moduleId, status, submittedAt, finalScore])
  @@map("quiz_attempts")
}

/// One settlement window (typically a calendar month).
model RevenuePeriod {
  id                    String              @id @default(uuid()) @db.Uuid
  periodStart           DateTime            @map("period_start")
  periodEnd             DateTime            @map("period_end")
  grossRevenueLkr       Decimal             @default(0) @map("gross_revenue_lkr") @db.Decimal(12, 2)
  platformShareLkr      Decimal             @default(0) @map("platform_share_lkr") @db.Decimal(12, 2)
  teacherPoolLkr        Decimal             @default(0) @map("teacher_pool_lkr") @db.Decimal(12, 2)
  totalBillableAttempts Int                 @default(0) @map("total_billable_attempts")
  status                RevenuePeriodStatus @default(Open)
  calculatedAt          DateTime?           @map("calculated_at")
  settledAt             DateTime?           @map("settled_at")
  notes                 String?
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  teacherShares TeacherRevenueShare[]
  payouts       TeacherPayout[]

  @@unique([periodStart])
  @@index([status])
  @@map("revenue_periods")
}

model TeacherRevenueShare {
  id            String        @id @default(uuid()) @db.Uuid
  periodId      String        @map("period_id") @db.Uuid
  period        RevenuePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  teacherUserId String        @map("teacher_user_id") @db.Uuid
  teacher       User          @relation("TeacherRevenueShares", fields: [teacherUserId], references: [id], onDelete: Cascade)
  attemptCount  Int           @map("attempt_count")
  shareRatio    Decimal       @map("share_ratio") @db.Decimal(12, 8)
  amountLkr     Decimal       @map("amount_lkr") @db.Decimal(12, 2)
  createdAt     DateTime      @default(now()) @map("created_at")

  @@unique([periodId, teacherUserId])
  @@index([teacherUserId])
  @@map("teacher_revenue_shares")
}

model TeacherPayout {
  id            String              @id @default(uuid()) @db.Uuid
  periodId      String              @map("period_id") @db.Uuid
  period        RevenuePeriod       @relation(fields: [periodId], references: [id], onDelete: Cascade)
  teacherUserId String              @map("teacher_user_id") @db.Uuid
  teacher       User                @relation("TeacherPayouts", fields: [teacherUserId], references: [id], onDelete: Cascade)
  amountLkr     Decimal             @map("amount_lkr") @db.Decimal(12, 2)
  status        TeacherPayoutStatus @default(Pending)
  paidAt        DateTime?           @map("paid_at")
  reference     String?
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@unique([periodId, teacherUserId])
  @@index([teacherUserId])
  @@index([status])
  @@map("teacher_payouts")
}

model TeacherPayoutProfile {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountName   String?  @map("account_name") @db.VarChar(255)
  bankName      String?  @map("bank_name") @db.VarChar(255)
  accountNumber String?  @map("account_number") @db.VarChar(64)
  branch        String?  @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("teacher_payout_profiles")
}

model StudentResponse {
  id                String       @id @default(uuid()) @db.Uuid
  attemptId         String       @map("attempt_id") @db.Uuid
  attempt           QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId        String       @map("question_id") @db.Uuid
  question          Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedChoiceId  String?      @map("selected_choice_id") @db.Uuid
  selectedChoice    AnswerChoice? @relation(fields: [selectedChoiceId], references: [id])
  textResponse      String?      @map("text_response")
  timeSpentSeconds  Int          @default(0) @map("time_spent_seconds")
  isCorrect         Boolean      @default(false) @map("is_correct")
  needsManualReview Boolean      @default(false) @map("needs_manual_review")

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
  @@map("student_responses")
}

model ChatLead {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String?
  mobileNumber String   @map("mobile_number")
  age          Int?
  school       String?
  tag          String   @default("Chatbot")
  /// Set when tag is "Quiz Attempt" — the quiz the guest started.
  quizId       String?  @map("quiz_id") @db.Uuid
  quiz         Quiz?    @relation(fields: [quizId], references: [id], onDelete: SetNull)
  /// Denormalized display title (usually English) for the leads table.
  quizTitle    String?  @map("quiz_title") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([quizId])
  @@map("chat_leads")
}

// ============================================================================
// PHASE 1 — Classroom LMS: Batches, Co-Teachers, Schedules & Enrollments
// ============================================================================

enum ClassBatchStatus {
  Draft
  Published
  Archived
}

enum ClassTeacherScope {
  OWNER
  INSTRUCTOR
  ASSISTANT
}

enum ClassLocationType {
  ONLINE
  PHYSICAL
  HYBRID
}

enum ClassEnrollmentStatus {
  INVITED
  PENDING
  ACTIVE
  SUSPENDED
  LEFT
  REJECTED
}

model ClassBatch {
  id               String            @id @default(uuid()) @db.Uuid
  courseId         String            @map("course_id") @db.Uuid
  course           Course            @relation(fields: [courseId], references: [id], onDelete: Restrict)
  workspaceId      String?           @map("workspace_id") @db.Uuid
  workspace        Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  primaryTeacherId String            @map("primary_teacher_id") @db.Uuid
  primaryTeacher   User              @relation("ClassBatchPrimaryTeacher", fields: [primaryTeacherId], references: [id], onDelete: Restrict)
  title            Json
  description      Json?
  grade            String?           @db.VarChar(64)
  subject          String?           @db.VarChar(120)
  academicYear     Int               @map("academic_year")
  languages        ContentLanguage[] @default([en])
  capacity         Int?
  startDate        DateTime?         @map("start_date")
  endDate          DateTime?         @map("end_date")
  status           ClassBatchStatus  @default(Draft)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  teachers        ClassTeacher[]
  schedules       ClassSchedule[]
  enrollments     ClassEnrollment[]
  invitations     ClassInvitation[]
  lessonProgress  LessonProgress[]
  quizAssignments ClassQuizAssignment[]
  sessions        ClassSession[]
  feePlans        ClassFeePlan[]
  tuitionInvoices TuitionInvoice[]
  billingAudits   TuitionBillingAuditEvent[]

  @@index([courseId])
  @@index([workspaceId])
  @@index([primaryTeacherId])
  @@index([status])
  @@index([academicYear])
  @@index([grade])
  @@map("class_batches")
}

model ClassTeacher {
  id              String            @id @default(uuid()) @db.Uuid
  classId         String            @map("class_id") @db.Uuid
  classBatch      ClassBatch        @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherId       String            @map("teacher_id") @db.Uuid
  teacher         User              @relation("ClassTeacherUser", fields: [teacherId], references: [id], onDelete: Cascade)
  permissionScope ClassTeacherScope @default(INSTRUCTOR) @map("permission_scope")
  createdAt       DateTime          @default(now()) @map("created_at")

  @@unique([classId, teacherId])
  @@index([teacherId])
  @@map("class_teachers")
}

model ClassSchedule {
  id             String            @id @default(uuid()) @db.Uuid
  classId        String            @map("class_id") @db.Uuid
  classBatch     ClassBatch        @relation(fields: [classId], references: [id], onDelete: Cascade)
  /// 0 = Sunday .. 6 = Saturday
  weekday        Int
  /// 24-hour local time "HH:mm"
  localStartTime String            @map("local_start_time") @db.VarChar(5)
  /// 24-hour local time "HH:mm"
  localEndTime   String            @map("local_end_time") @db.VarChar(5)
  timezone       String            @default("Asia/Colombo") @db.VarChar(64)
  locationType   ClassLocationType @default(ONLINE) @map("location_type")
  locationValue  String?           @map("location_value") @db.VarChar(500)
  effectiveFrom  DateTime          @default(now()) @map("effective_from")
  effectiveTo    DateTime?         @map("effective_to")
  createdById    String?           @map("created_by_id") @db.Uuid
  createdBy      User?             @relation("ClassScheduleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById    String?           @map("updated_by_id") @db.Uuid
  updatedBy      User?             @relation("ClassScheduleUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  sessions       ClassSession[]

  @@index([classId, weekday])
  @@map("class_schedules")
}

model ClassEnrollment {
  id           String                @id @default(uuid()) @db.Uuid
  classId      String                @map("class_id") @db.Uuid
  classBatch   ClassBatch            @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId    String                @map("student_id") @db.Uuid
  student      User                  @relation("StudentClassEnrollments", fields: [studentId], references: [id], onDelete: Cascade)
  status       ClassEnrollmentStatus @default(ACTIVE)
  studentCode  String?               @map("student_code") @db.VarChar(64)
  note         String?               @db.VarChar(500)
  invitationId String?               @map("invitation_id") @db.Uuid
  invitation   ClassInvitation?      @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  joinedAt     DateTime              @default(now()) @map("joined_at")
  endedAt      DateTime?             @map("ended_at")
  approvedById String?               @map("approved_by") @db.Uuid
  approvedBy   User?                 @relation("ApprovedClassEnrollments", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?             @map("approved_at")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  tuitionInvoices TuitionInvoice[]

  @@unique([classId, studentId])
  @@index([studentId, status])
  @@index([classId, status])
  @@index([invitationId])
  @@map("class_enrollments")
}

model ClassInvitation {
  id               String            @id @default(uuid()) @db.Uuid
  classId          String            @map("class_id") @db.Uuid
  classBatch       ClassBatch        @relation(fields: [classId], references: [id], onDelete: Cascade)
  tokenHash        String            @unique @map("token_hash") @db.VarChar(128)
  codeHint         String            @map("code_hint") @db.VarChar(32)
  label            String?           @db.VarChar(120)
  requiresApproval Boolean           @default(true) @map("requires_approval")
  expiresAt        DateTime          @map("expires_at")
  maxUses          Int?              @map("max_uses")
  usedCount        Int               @default(0) @map("used_count")
  createdById      String            @map("created_by") @db.Uuid
  createdBy        User              @relation("ClassInvitationsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  revokedAt        DateTime?         @map("revoked_at")
  createdAt        DateTime          @default(now()) @map("created_at")

  enrollments      ClassEnrollment[]

  @@index([classId, revokedAt, expiresAt])
  @@index([createdById])
  @@map("class_invitations")
}

// ============================================================================
// PHASE 3 — Lessons, Protected Resources, Completion Progress & Quiz Reuse
// ============================================================================

enum LessonStatus {
  Draft
  Published
  Scheduled
  Archived
}

enum LessonResourceType {
  PDF
  DOCUMENT
  IMAGE
  VIDEO_EMBED
  EXTERNAL_LINK
  TEACHER_NOTE
}

enum LessonResourceAccessPolicy {
  VIEW_ONLY
  DOWNLOADABLE
}

enum LessonResourceScanStatus {
  CLEAN
  PENDING
  QUARANTINED
}

enum ClassQuizAssignmentStatus {
  Draft
  Published
  Archived
}

model Lesson {
  id               String                @id @default(uuid()) @db.Uuid
  moduleId         String                @map("module_id") @db.Uuid
  module           Module                @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title            Json
  summary          Json?
  body             Json?
  sortOrder        Int                   @default(0) @map("sort_order")
  status           LessonStatus          @default(Draft)
  publishAt        DateTime?             @map("publish_at")
  estimatedMinutes Int?                  @map("estimated_minutes")
  createdById      String?               @map("created_by") @db.Uuid
  createdBy        User?                 @relation("LessonCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  resources        LessonResource[]
  progressRecords  LessonProgress[]
  quizAssignments  ClassQuizAssignment[]

  @@index([moduleId, sortOrder])
  @@index([moduleId, status])
  @@map("lessons")
}

model LessonResource {
  id             String                     @id @default(uuid()) @db.Uuid
  lessonId       String                     @map("lesson_id") @db.Uuid
  lesson         Lesson                     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title          Json
  type           LessonResourceType
  storageKey     String?                    @map("storage_key") @db.VarChar(500)
  fileName       String?                    @map("file_name") @db.VarChar(255)
  externalUrl    String?                    @map("external_url") @db.VarChar(1000)
  noteText       Json?                      @map("note_text")
  mimeType       String?                    @map("mime_type") @db.VarChar(128)
  sizeBytes      Int?                       @map("size_bytes")
  accessPolicy   LessonResourceAccessPolicy @default(DOWNLOADABLE) @map("access_policy")
  sortOrder      Int                        @default(0) @map("sort_order")
  scanStatus     LessonResourceScanStatus   @default(CLEAN) @map("scan_status")
  checksumSha256 String?                    @map("checksum_sha256") @db.VarChar(64)
  createdById    String?                    @map("created_by") @db.Uuid
  createdBy      User?                      @relation("LessonResourceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")

  @@index([lessonId, sortOrder])
  @@map("lesson_resources")
}

model LessonProgress {
  id          String     @id @default(uuid()) @db.Uuid
  classId     String     @map("class_id") @db.Uuid
  classBatch  ClassBatch @relation(fields: [classId], references: [id], onDelete: Cascade)
  lessonId    String     @map("lesson_id") @db.Uuid
  lesson      Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId   String     @map("student_id") @db.Uuid
  student     User       @relation("StudentLessonProgress", fields: [studentId], references: [id], onDelete: Cascade)
  completedAt DateTime   @default(now()) @map("completed_at")

  @@unique([classId, studentId, lessonId])
  @@index([studentId, classId])
  @@index([lessonId])
  @@map("lesson_progress")
}

model ClassQuizAssignment {
  id            String                    @id @default(uuid()) @db.Uuid
  classId       String                    @map("class_id") @db.Uuid
  classBatch    ClassBatch                @relation(fields: [classId], references: [id], onDelete: Cascade)
  lessonId      String?                   @map("lesson_id") @db.Uuid
  lesson        Lesson?                   @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  quizId        String                    @map("quiz_id") @db.Uuid
  quiz          Quiz                      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  displayTitle  Json?                     @map("display_title")
  availableFrom DateTime?                 @map("available_from")
  dueAt         DateTime?                 @map("due_at")
  status        ClassQuizAssignmentStatus @default(Published)
  assignedById  String?                   @map("assigned_by") @db.Uuid
  assignedBy    User?                     @relation("ClassQuizAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  createdAt     DateTime                  @default(now()) @map("created_at")
  updatedAt     DateTime                  @updatedAt @map("updated_at")

  @@unique([classId, quizId])
  @@index([classId, status])
  @@index([lessonId])
  @@index([quizId])
  @@map("class_quiz_assignments")
}

// ============================================================================
// PHASE 4 — Class Sessions, Attendance Records & Correction Audit Trail
// ============================================================================

enum ClassSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  UNMARKED
}

model ClassSession {
  id                 String             @id @default(uuid()) @db.Uuid
  classId            String             @map("class_id") @db.Uuid
  classBatch         ClassBatch         @relation(fields: [classId], references: [id], onDelete: Cascade)
  scheduleId         String?            @map("schedule_id") @db.Uuid
  schedule           ClassSchedule?     @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  startsAtUtc        DateTime           @map("starts_at_utc")
  endsAtUtc          DateTime           @map("ends_at_utc")
  localDate          String             @map("local_date") @db.VarChar(10)
  timezone           String             @default("Asia/Colombo") @db.VarChar(64)
  status             ClassSessionStatus @default(SCHEDULED)
  title              Json?
  cancellationReason String?            @map("cancellation_reason") @db.VarChar(500)
  isLocked           Boolean            @default(false) @map("is_locked")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  attendanceRecords  AttendanceRecord[]
  attendanceChanges  AttendanceChange[]

  @@unique([classId, startsAtUtc])
  @@index([classId, localDate])
  @@index([classId, status])
  @@map("class_sessions")
}

model AttendanceRecord {
  id             String           @id @default(uuid()) @db.Uuid
  classSessionId String           @map("class_session_id") @db.Uuid
  classSession   ClassSession     @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  studentId      String           @map("student_id") @db.Uuid
  student        User             @relation("StudentAttendanceRecords", fields: [studentId], references: [id], onDelete: Cascade)
  status         AttendanceStatus @default(UNMARKED)
  note           String?          @db.VarChar(500)
  markedById     String?          @map("marked_by") @db.Uuid
  markedBy       User?            @relation("TeacherAttendanceMarked", fields: [markedById], references: [id], onDelete: SetNull)
  markedAt       DateTime         @default(now()) @map("marked_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  changes        AttendanceChange[]

  @@unique([classSessionId, studentId])
  @@index([studentId, status])
  @@index([classSessionId, status])
  @@map("attendance_records")
}

model AttendanceChange {
  id                 String            @id @default(uuid()) @db.Uuid
  attendanceRecordId String            @map("attendance_record_id") @db.Uuid
  attendanceRecord   AttendanceRecord  @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  classSessionId     String            @map("class_session_id") @db.Uuid
  classSession       ClassSession      @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  studentId          String            @map("student_id") @db.Uuid
  student            User              @relation("StudentAttendanceChanges", fields: [studentId], references: [id], onDelete: Cascade)
  actorId            String?           @map("actor_id") @db.Uuid
  actor              User?             @relation("ActorAttendanceChanges", fields: [actorId], references: [id], onDelete: SetNull)
  previousStatus     AttendanceStatus? @map("previous_status")
  newStatus          AttendanceStatus  @map("new_status")
  reason             String?           @db.VarChar(500)
  changedAt          DateTime          @default(now()) @map("changed_at")

  @@index([classSessionId, changedAt])
  @@index([studentId, changedAt])
  @@map("attendance_changes")
}

// ============================================================================
// PHASE 5 — Tuition Billing, Fee Plans, Student Invoices, Adjustments & Ledger
// ============================================================================

enum ClassFeeFrequency {
  MONTHLY
  ONE_TIME
}

enum ClassProrationPolicy {
  FULL_MONTH
  PRORATE_BY_DAYS
}

enum ClassOverdueAccessPolicy {
  ALLOW_WITH_WARNING
  BLOCK_AFTER_GRACE
}

enum TuitionInvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOIDED
  WAIVED
}

enum TuitionAdjustmentType {
  DISCOUNT
  WAIVER
  SURCHARGE
  VOID
}

enum TuitionPaymentChannel {
  ONLINE_GATEWAY
  BANK_TRANSFER
  CASH
  SCHOLARSHIP
}

enum TuitionPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CHARGEBACK
}

model ClassFeePlan {
  id                  String                   @id @default(uuid()) @db.Uuid
  classId             String                   @map("class_id") @db.Uuid
  classBatch          ClassBatch               @relation(fields: [classId], references: [id], onDelete: Cascade)
  name                Json?
  version             Int                      @default(1)
  amountMinor         Int                      @map("amount_minor")
  currency            String                   @default("LKR") @db.VarChar(8)
  frequency           ClassFeeFrequency        @default(MONTHLY)
  dueDay              Int                      @default(10) @map("due_day")
  graceDays           Int                      @default(5) @map("grace_days")
  prorationPolicy     ClassProrationPolicy     @default(FULL_MONTH) @map("proration_policy")
  overdueAccessPolicy ClassOverdueAccessPolicy @default(ALLOW_WITH_WARNING) @map("overdue_access_policy")
  activeFrom          DateTime                 @default(now()) @map("active_from")
  activeTo            DateTime?                @map("active_to")
  isActive            Boolean                  @default(true) @map("is_active")
  createdById         String?                  @map("created_by") @db.Uuid
  createdBy           User?                    @relation("ClassFeePlanCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  invoices            TuitionInvoice[]

  @@index([classId, isActive, version])
  @@map("class_fee_plans")
}

model TuitionInvoice {
  id               String                     @id @default(uuid()) @db.Uuid
  classId          String                     @map("class_id") @db.Uuid
  classBatch       ClassBatch                 @relation(fields: [classId], references: [id], onDelete: Cascade)
  enrollmentId     String                     @map("enrollment_id") @db.Uuid
  enrollment       ClassEnrollment            @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  studentId        String                     @map("student_id") @db.Uuid
  student          User                       @relation("StudentTuitionInvoices", fields: [studentId], references: [id], onDelete: Cascade)
  feePlanId        String                     @map("fee_plan_id") @db.Uuid
  feePlan          ClassFeePlan               @relation(fields: [feePlanId], references: [id], onDelete: Restrict)
  periodYyyyMm     String                     @map("period_yyyy_mm") @db.VarChar(7)
  invoiceNumber    String                     @unique @map("invoice_number") @db.VarChar(64)
  currency         String                     @default("LKR") @db.VarChar(8)
  subtotalMinor    Int                        @map("subtotal_minor")
  discountMinor    Int                        @default(0) @map("discount_minor")
  surchargeMinor   Int                        @default(0) @map("surcharge_minor")
  totalMinor       Int                        @map("total_minor")
  paidMinor        Int                        @default(0) @map("paid_minor")
  balanceMinor     Int                        @map("balance_minor")
  dueAt            DateTime                   @map("due_at")
  graceDays        Int                        @default(5) @map("grace_days")
  status           TuitionInvoiceStatus       @default(ISSUED)
  planSnapshotJson Json                       @map("plan_snapshot_json")
  notes            String?                    @db.VarChar(500)
  issuedAt         DateTime                   @default(now()) @map("issued_at")
  paidAt           DateTime?                  @map("paid_at")
  voidedAt         DateTime?                  @map("voided_at")
  createdAt        DateTime                   @default(now()) @map("created_at")
  updatedAt        DateTime                   @updatedAt @map("updated_at")

  adjustments      TuitionInvoiceAdjustment[]
  allocations      TuitionPaymentAllocation[]
  auditEvents      TuitionBillingAuditEvent[]
  manualSubmissions TuitionManualPaymentSubmission[]
  receipts         TuitionReceipt[]

  @@unique([enrollmentId, periodYyyyMm])
  @@unique([classId, studentId, periodYyyyMm])
  @@index([classId, periodYyyyMm, status])
  @@index([studentId, periodYyyyMm])
  @@map("tuition_invoices")
}

model TuitionInvoiceAdjustment {
  id          String                @id @default(uuid()) @db.Uuid
  invoiceId   String                @map("invoice_id") @db.Uuid
  invoice     TuitionInvoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type        TuitionAdjustmentType
  amountMinor Int                   @map("amount_minor")
  reason      String                @db.VarChar(500)
  actorId     String?               @map("actor_id") @db.Uuid
  actor       User?                 @relation("ActorTuitionAdjustments", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt   DateTime              @default(now()) @map("created_at")

  @@index([invoiceId, createdAt])
  @@map("tuition_invoice_adjustments")
}

model TuitionPayment {
  id                String                     @id @default(uuid()) @db.Uuid
  classId           String                     @map("class_id") @db.Uuid
  payerId           String                     @map("payer_id") @db.Uuid
  payer             User                       @relation("StudentTuitionPayments", fields: [payerId], references: [id], onDelete: Cascade)
  channel           TuitionPaymentChannel      @default(CASH)
  gateway           String?                    @db.VarChar(64)
  providerOrderId   String?                    @unique @map("provider_order_id") @db.VarChar(64)
  providerPaymentId String?                    @map("provider_payment_id") @db.VarChar(128)
  externalReference String?                    @unique @map("external_reference") @db.VarChar(128)
  currency          String                     @default("LKR") @db.VarChar(8)
  amountMinor       Int                        @map("amount_minor")
  refundedMinor     Int                        @default(0) @map("refunded_minor")
  status            TuitionPaymentStatus       @default(PENDING)
  isTestMode        Boolean                    @default(false) @map("is_test_mode")
  notes             String?                    @db.VarChar(500)
  refundReason      String?                    @map("refund_reason") @db.VarChar(500)
  verifiedById      String?                    @map("verified_by") @db.Uuid
  verifiedBy        User?                      @relation("VerifierTuitionPayments", fields: [verifiedById], references: [id], onDelete: SetNull)
  confirmedAt       DateTime?                  @map("confirmed_at")
  refundedAt        DateTime?                  @map("refunded_at")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")

  allocations       TuitionPaymentAllocation[]
  events            TuitionPaymentEvent[]
  manualSubmission  TuitionManualPaymentSubmission?
  receipt           TuitionReceipt?

  @@index([classId, status])
  @@index([payerId, createdAt])
  @@map("tuition_payments")
}

model TuitionPaymentAllocation {
  id          String         @id @default(uuid()) @db.Uuid
  paymentId   String         @map("payment_id") @db.Uuid
  payment     TuitionPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId   String         @map("invoice_id") @db.Uuid
  invoice     TuitionInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amountMinor Int            @map("amount_minor")
  createdAt   DateTime       @default(now()) @map("created_at")

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
  @@map("tuition_payment_allocations")
}

model TuitionBillingAuditEvent {
  id             String          @id @default(uuid()) @db.Uuid
  classId        String          @map("class_id") @db.Uuid
  classBatch     ClassBatch      @relation(fields: [classId], references: [id], onDelete: Cascade)
  invoiceId      String?         @map("invoice_id") @db.Uuid
  invoice        TuitionInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  actorId        String?         @map("actor_id") @db.Uuid
  actor          User?           @relation("ActorTuitionBillingAudit", fields: [actorId], references: [id], onDelete: SetNull)
  action         String          @db.VarChar(64)
  previousValues Json?           @map("previous_values")
  newValues      Json?           @map("new_values")
  reason         String?         @db.VarChar(500)
  createdAt      DateTime        @default(now()) @map("created_at")

  @@index([classId, createdAt])
  @@index([invoiceId, createdAt])
  @@map("tuition_billing_audit_events")
}

// ============================================================================
// PHASE 6 — Payment Gateway Events, Manual Cash/Bank Submissions & Receipts
// ============================================================================

model TuitionPaymentEvent {
  id              String          @id @default(uuid()) @db.Uuid
  provider        String          @db.VarChar(32)
  externalEventId String          @map("external_event_id") @db.VarChar(128)
  paymentId       String?         @map("payment_id") @db.Uuid
  payment         TuitionPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  payloadHash     String          @map("payload_hash") @db.VarChar(64)
  rawPayload      Json            @map("raw_payload")
  status          String          @default("PROCESSED") @db.VarChar(32)
  errorMessage    String?         @map("error_message") @db.VarChar(500)
  receivedAt      DateTime        @default(now()) @map("received_at")
  processedAt     DateTime?       @map("processed_at")

  @@unique([provider, externalEventId])
  @@index([paymentId])
  @@map("tuition_payment_events")
}

model TuitionManualPaymentSubmission {
  id                  String                @id @default(uuid()) @db.Uuid
  invoiceId           String                @map("invoice_id") @db.Uuid
  invoice             TuitionInvoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  classId             String                @map("class_id") @db.Uuid
  studentId           String                @map("student_id") @db.Uuid
  student             User                  @relation("StudentManualTuitionSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  paymentId           String?               @unique @map("payment_id") @db.Uuid
  payment             TuitionPayment?       @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  channel             TuitionPaymentChannel @default(BANK_TRANSFER)
  amountMinor         Int                   @map("amount_minor")
  currency            String                @default("LKR") @db.VarChar(8)
  referenceNumber     String                @map("reference_number") @db.VarChar(128)
  paidDate            String                @map("paid_date") @db.VarChar(10)
  proofStorageKey     String?               @map("proof_storage_key") @db.VarChar(500)
  proofFileName       String?               @map("proof_file_name") @db.VarChar(255)
  proofMimeType       String?               @map("proof_mime_type") @db.VarChar(128)
  proofChecksumSha256 String?               @map("proof_checksum_sha256") @db.VarChar(64)
  note                String?               @db.VarChar(500)
  status              SlipSubmissionStatus  @default(Pending)
  reviewedById        String?               @map("reviewed_by") @db.Uuid
  reviewedBy          User?                 @relation("ReviewerManualTuitionSubmissions", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt          DateTime?             @map("reviewed_at")
  reviewReason        String?               @map("review_reason") @db.VarChar(500)
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  @@unique([channel, referenceNumber])
  @@index([classId, status, createdAt])
  @@index([invoiceId, status])
  @@index([studentId, createdAt])
  @@index([proofChecksumSha256])
  @@map("tuition_manual_payment_submissions")
}

model TuitionReceipt {
  id                String         @id @default(uuid()) @db.Uuid
  receiptNumber     String         @unique @map("receipt_number") @db.VarChar(64)
  paymentId         String         @unique @map("payment_id") @db.Uuid
  payment           TuitionPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId         String         @map("invoice_id") @db.Uuid
  invoice           TuitionInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  classId           String         @map("class_id") @db.Uuid
  studentId         String         @map("student_id") @db.Uuid
  student           User           @relation("StudentTuitionReceipts", fields: [studentId], references: [id], onDelete: Cascade)
  currency          String         @default("LKR") @db.VarChar(8)
  paidAmountMinor   Int            @map("paid_amount_minor")
  balanceAfterMinor Int            @map("balance_after_minor")
  status            String         @default("ISSUED") @db.VarChar(32)
  snapshotJson      Json           @map("snapshot_json")
  issuedAt          DateTime       @default(now()) @map("issued_at")

  @@index([classId, issuedAt])
  @@index([studentId, issuedAt])
  @@index([invoiceId])
  @@map("tuition_receipts")
}


